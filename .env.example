# =============================================================================
# Sila & Kimsour Wedding Platform — environment variables
# Copy to `.env` for local development. NEVER commit real values.
# All variables are validated at startup by src/lib/env.ts.
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# =============================================================================

# --- Database ---------------------------------------------------------------
# App runtime connection. In production use a least-privilege role (DML only, no DDL).
DATABASE_URL="postgresql://wedding:wedding_local_dev_only@localhost:5433/wedding_dev"
# Direct (non-pooled) connection used by `prisma migrate`. Migration role (DDL allowed).
DIRECT_URL="postgresql://wedding:wedding_local_dev_only@localhost:5433/wedding_dev"
# Optional: CA certificate (PEM) of a managed database that uses its own CA (Aiven, AWS RDS…).
# Needed when the URL has sslmode=require and the server certificate is not publicly trusted
# (error: "self-signed certificate in certificate chain"). Paste the PEM; on one line use \n for newlines.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Integration tests only. Tests WIPE this database. Never point it at real data.
TEST_DATABASE_URL="postgresql://wedding:wedding_local_dev_only@localhost:5433/wedding_test"

# --- App --------------------------------------------------------------------
# Canonical public origin. Used for invitation links, QR codes and Origin checks.
APP_URL="http://localhost:5000"
# 'kh' (Khmer) or 'en'. Public (inlined at build): default language for new visitors.
NEXT_PUBLIC_DEFAULT_LOCALE="kh"
TIME_ZONE="Asia/Phnom_Penh"
# debug | info | warn | error
LOG_LEVEL="info"

# --- Secrets (each at least 32 random bytes) ---------------------------------
# Signs the guest invitation cookie.
AUTH_SECRET=""
# HMAC key for invitation token lookup. CHANGING IT INVALIDATES EVERY INVITATION LINK.
TOKEN_HASH_PEPPER=""
# 32 random bytes, base64. AES-256-GCM key so admins can re-display invitation links.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""
# Bearer secret for /api/cron/cleanup.
CRON_SECRET=""

# --- Media --------------------------------------------------------------------
# 'cloudinary' (required in production) or 'local' (development only: files under ./.uploads)
MEDIA_STORAGE="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Separate folder per environment, e.g. sila-kimsour-prod
CLOUDINARY_FOLDER="sila-kimsour-dev"
# Public (not secret): used to build image URLs in the browser.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Seed only (Phase 3) ---------------------------------------------------------
# Used once by `npm run db:seed` to create the shared admin account. Remove afterwards.
# ADMIN_SEED_USERNAME=""
# ADMIN_SEED_PASSWORD=""
